## 7. 复跑命令

```
cd .
T=toolchains/riscv32-unknown-elf-newlib-multilib/bin
# 改前：还原 HEAD 版 Eth.c 后构建
cp mcal/Eth/src/Eth.c /tmp/Eth.c.new && git checkout -- mcal/Eth/src/Eth.c
bash scripts/build.sh samples/mcal/eth_raw_echo
cp build/eth_raw_echo-debug/output/demo.elf /tmp/before.elf && cp build/eth_raw_echo-debug/output/demo.bin /tmp/before.bin
# 改后：换回新版本再构建
cp /tmp/Eth.c.new mcal/Eth/src/Eth.c && bash scripts/build.sh samples/mcal/eth_raw_echo
cp build/eth_raw_echo-debug/output/demo.elf /tmp/after.elf && cp build/eth_raw_echo-debug/output/demo.bin /tmp/after.bin
# 对比
$T/riscv32-unknown-elf-size /tmp/before.elf /tmp/after.elf
$T/riscv32-unknown-elf-readelf -SW /tmp/before.elf | grep noncacheable
$T/riscv32-unknown-elf-readelf -lW /tmp/before.elf | grep -E "LOAD.*0x01230000"
$T/riscv32-unknown-elf-readelf -lW /tmp/after.elf  | grep -E "LOAD.*0x01230000"
stat -c "%n %s" /tmp/before.bin /tmp/after.bin
grep -n "__fw_size__" build/eth_raw_echo-debug/output/demo.map
```

