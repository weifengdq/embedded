5319:                0x0000000001239300                __noncacheable_bss_end__ = .
5355:                0x0000000000014e50                __fw_size__ = ((((((((((SIZEOF (.start) + SIZEOF (.vectors)) + SIZEOF (.rel)) + SIZEOF (.text)) + SIZEOF (.data)) + SIZEOF (.fast)) + SIZEOF (.tdata)) + SIZEOF (.noncacheable.init)) + SIZEOF (.fast_ram.init)) + SIZEOF (.eh_frame)) + SIZEOF (.eh_frame_hdr))
5357:                0x0000000000000001                ASSERT (((__fw_size__ <= LENGTH (FLASH)) && (__last_addr__ <= (ORIGIN (FLASH) + LENGTH (FLASH)))), ******  FAILED! FLASH does not have enough space!  ******)
```

改前输出段：
```
5307:.noncacheable   0x0000000001230000     0x9300
5308-                0x0000000001230000                . = ALIGN (0x8)
5309- *(.noncacheable)
5310- .noncacheable  0x0000000001230000     0x9300 CMakeFiles/app.dirmcal/Eth/src/Eth.c.obj
5311- *(.noncacheable.non_init)
5312- *(.noncacheable.non_init.*)
5313-                0x0000000001239300                . = ALIGN (0x8)
5314-                0x0000000001239300                __noncacheable_bss_start__ = .
5315- *(.noncacheable.bss)
5316- *(.noncacheable.bss.*)
5317-                0x0000000001239300                . = ALIGN (0x8)
```
改后输出段：
```
5307:.noncacheable   0x0000000001230000     0x9300
5308-                0x0000000001230000                . = ALIGN (0x8)
5309- *(.noncacheable)
5310- *(.noncacheable.non_init)
5311- *(.noncacheable.non_init.*)
5312-                0x0000000001230000                . = ALIGN (0x8)
5313-                0x0000000001230000                __noncacheable_bss_start__ = .
5314- *(.noncacheable.bss)
5315- .noncacheable.bss
5316-                0x0000000001230000     0x9300 CMakeFiles/app.dirmcal/Eth/src/Eth.c.obj
5317- *(.noncacheable.bss.*)
```

唯一变化：__noncacheable_bss_start__ 从 0x01239300 前移到 0x01230000，即整段 37 632 B 落进 __noncacheable_bss_start__..__noncacheable_bss_end__，startup 会清零它（见 §5）。输出段地址/大小/镜像都不变。

## 4. Eth.c.obj 段属性（解释 R7 的 135.8 KiB 从哪来）

改前 .obj：
```
  5 .noncacheable 00009300  00000000  00000000  000000c0  2**6
                  CONTENTS, ALLOC, LOAD, DATA
```
改后 .obj：
```
  5 .noncacheable.bss 00009300  00000000  00000000  000000c0  2**6
                  CONTENTS, ALLOC, LOAD, DATA
```
GCC 对带 section 属性的未初始化数组仍发 PROGBITS（CONTENTS/LOAD），所以 riscv32-unknown-elf-size Eth.c.obj 的 data 一直是 37 632；
但链接脚本把该输入段放进 NOLOAD 输出段，最终 ELF 里没有内容。R7 用 .obj 的 text+data 当 Flash 是口径错误。

## 5. startup 清零证据（.noncacheable.bss 在清零范围内）

```
35:static void section_clear(uint8_t *dst_start, uint8_t *dst_end)
103:    extern uint8_t __noncacheable_bss_start__[], __noncacheable_bss_end__[];
116:    section_clear(__bss_start__, __bss_end__);
119:    section_clear(__noncacheable_bss_start__, __noncacheable_bss_end__);
122:    section_clear(__fast_ram_bss_start__, __fast_ram_bss_end__);
```

reset.c:119 section_clear(__noncacheable_bss_start__, __noncacheable_bss_end__) 覆盖整段；描述符另由 Eth_Init memset（mcal/Eth/src/Eth.c 第 321-322 行）。

