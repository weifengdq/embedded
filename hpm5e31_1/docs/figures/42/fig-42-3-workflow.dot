digraph G {
  rankdir=LR; nodesep=0.25; ranksep=0.30; pad=0.10;
  graph [fontname="Noto Sans CJK SC", bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10,
        color="#57606A", fillcolor="#F6F8FA"];
